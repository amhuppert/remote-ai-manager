+// Splits the JSONL stream on "\n" only. Node 24's readline also treats
+// U+2028 / U+2029 as line terminators, and codex emits both unescaped inside
+// JSON strings, so a readline-based split shattered events mid-string.
+async function* readJsonLines(stream) {
+  const decoder = new TextDecoder("utf-8");
+  let pending = "";
+  for await (const chunk of stream) {
+    pending += decoder.decode(chunk, { stream: true });
+    let newline = pending.indexOf("\n");
+    while (newline !== -1) {
+      const line = pending.slice(0, newline);
+      pending = pending.slice(newline + 1);
+      yield line.endsWith("\r") ? line.slice(0, -1) : line;
+      newline = pending.indexOf("\n");
+    }
+  }
+  pending += decoder.decode();
+  if (pending.length > 0) {
+    yield pending.endsWith("\r") ? pending.slice(0, -1) : pending;
+  }
