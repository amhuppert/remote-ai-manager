{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/components/BackendToggle/**",
              "components/components/BranchSelector/**",
              "components/components/CardContextMenu/**",
              "components/components/CollapsibleText/**",
              "components/components/ConfirmDialog/**",
              "components/components/ContextFillIndicator/**",
              "components/components/ConversationNav/**",
              "components/components/CopyableId/**",
              "components/components/MarkdownContent/**",
              "components/components/MergeToast/**",
              "components/components/ModelSelector/**",
              "components/components/ReasoningLevelSelector/**",
              "components/components/TddToggle/**",
              "components/conversation/EffortLabel/**",
              "components/ui/Accordion/**",
              "components/ui/AlertDialog/**",
              "components/ui/Autocomplete/**",
              "components/ui/Badge/**",
              "components/ui/Button/**",
              "components/ui/Checkbox/**",
              "components/ui/Collapsible/**",
              "components/ui/ContextMenu/**",
              "components/ui/Dialog/**",
              "components/ui/DropdownMenu/**",
              "components/ui/EmptyState/**",
              "components/ui/FormField/**",
              "components/ui/IconButton/**",
              "components/ui/Popover/**",
              "components/ui/Progress/**",
              "components/ui/RadioGroup/**",
              "components/ui/SectionHeader/**",
              "components/ui/SegmentedControl/**",
              "components/ui/Select/**",
              "components/ui/StatusDot/**",
              "components/ui/Switch/**",
              "components/ui/Tabs/**",
              "components/ui/Tooltip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anybody|Manrope|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Anybody, Manrope, Geist Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
