{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "bun run build:info",
    "dev": "bun run build:info && bun run build:cli && PORT=${PORT:-3000} CC_ENV=dev CC_CONFIG_DIR=$PWD/.config next dev -p ${PORT:-3000}",
    "dev:main": "bun run build:info && bun run build:cli && PORT=${PORT:-3000} CC_ENV=dev next dev -p ${PORT:-3000}",
    "build": "bun run build:info && NODE_ENV=production next build && bun run build:cli",
    "build:info": "bun scripts/generate-build-info.ts",
    "build:cli": "bun build src/cli/index.ts --target=node --format=esm --outfile=dist/cctl/cctl.mjs --banner='#!/usr/bin/env node'",
    "start": "next start",
    "lint": "npx eslint . && bun run seams:check",
    "lint:ai": "npx eslint . --quiet --no-color --no-warn-ignored",
    "test:watch": "NODE_ENV=test vitest",
    "test": "NODE_ENV=test vitest run",
    "test:ai": "NODE_ENV=test vitest run --project unit-node --project unit-jsdom --no-color",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:ai": "tsc --noEmit --pretty false --project tsconfig.ai.json",
    "check:ai": "npx eslint . --ignore-pattern 'ds-bundle/**' --quiet --no-color --no-warn-ignored && tsc --noEmit --pretty false --project tsconfig.ai.json && NODE_ENV=test vitest run --project unit-node --project unit-jsdom --no-color",
    "css:inventory": "bun scripts/css-inventory.ts",
    "css:progress": "bun scripts/css-migration-progress.ts --check",
    "seams:check": "bun scripts/seam-adoption.ts --check",
    "cli:skill-ref": "bun scripts/cc-cli-skill-reference.ts --check",
    "logs:analyze": "bun scripts/analyze-logs.ts",
    "logs:duckdb": "scripts/duckdb-logs/run.sh",
    "workflow:audit": "bun scripts/workflow-audit/run.ts",
    "trace:speedscope": "bun scripts/speedscope-export.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "storybook": "NODE_ENV=development storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.219",
    "@dnd-kit/core": "6.3.1",
    "@floating-ui/react": "^0.27.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.144.1",
    "@react-hookz/web": "^25.2.0",
    "@recogito/react-text-annotator": "4.2.5",
    "@recogito/text-annotator": "4.2.5",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "ignore": "^7.0.5",
    "immer": "^11.1.4",
    "mermaid": "^11.12.3",
    "modern-screenshot": "^4.7.0",
    "next": "16.3.0-preview.10",
    "openseadragon": "^6.0.2",
    "radix-ui": "^1.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-scan": "^0.5.6",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.6",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.6.1",
    "svg-pan-zoom": "^3.6.2",
    "umzug": "^3.8.3",
    "xstate": "^5.28.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/css": "^1.3.0",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/nextjs-vite": "^10.2.10",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^3.2.1",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0-preview.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-storybook": "^10.2.10",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^6.14.2",
    "playwright": "^1.58.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.1"
  }
}
